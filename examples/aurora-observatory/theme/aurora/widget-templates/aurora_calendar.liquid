{% assign limit = widget.settings.limit | default: 6 %}
{% assign today = "now" | date: "%Y-%m-%d" %}
{% capture flt %}starts_on ge '{{ today }}'{% endcapture %}
{% if widget.settings.onlyStorms %}{% capture flt %}starts_on ge '{{ today }}' and event_type eq 'storm_watch'{% endcapture %}{% endif %}
{% assign list = get_content_items(ContentType="sky_events", Filter=flt, OrderBy="starts_on asc", PageSize=limit) %}
<section class="section{% if widget.css_class %} {{ widget.css_class }}{% endif %}" {% if widget.html_id %}id="{{ widget.html_id }}"{% endif %}>
  <div class="container">
    <div class="head-flex section-head reveal" style="max-width:none">
      <div style="max-width:720px">
        {% if widget.settings.eyebrow %}<div class="eyebrow">{{ widget.settings.eyebrow }}</div>{% endif %}
        <h2 style="margin-bottom:.3em">{{ widget.settings.heading }}</h2>
        {% if widget.settings.intro %}<p class="lede" style="margin:0">{{ widget.settings.intro }}</p>{% endif %}
      </div>
      {% if widget.settings.ctaText %}<a class="btn btn-ghost" href="{{ widget.settings.ctaUrl }}">{{ widget.settings.ctaText }}</a>{% endif %}
    </div>
    <div class="cal">
      {% for ev in list.Items %}
        {% assign c = ev.PublishedContent %}
        {% assign score = c.visibility.Value | default: 5 %}
        <article class="card cal-item reveal" style="--i:{{ forloop.index0 }};--accent:{{ c.event_color.Value | default: '#37ffb0' }}">
          <div class="cal-date"><b>{{ c.starts_on.Value | date: "%e" }}</b><span>{{ c.starts_on.Value | date: "%b" }}</span></div>
          <div>
            <h3><a class="stretch" href="{{ PathBase }}/{{ ev.RoutePath }}" style="color:inherit">{{ ev.PrimaryField }}</a></h3>
            <p>{{ c.event_type.Value | @event_type }}{% if c.ends_on.Value and c.ends_on.Value != c.starts_on.Value %} &middot; through {{ c.ends_on.Value | date: "%b %e" }}{% endif %}{% if c.livestream.Value %} &middot; live-streamed{% endif %}</p>
          </div>
          <div class="meter" title="Visibility {{ score }}/10">{% for i in (1..10) %}<i class="{% if i <= score %}on{% endif %}" style="height:{{ i | times: 3 | plus: 6 }}px"></i>{% endfor %}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
