<section class="section{% if widget.css_class %} {{ widget.css_class }}{% endif %}" {% if widget.html_id %}id="{{ widget.html_id }}"{% endif %}>
  <div class="container">
    <div class="map-wrap">
      <div class="reveal">
        {% if widget.settings.eyebrow %}<div class="eyebrow">{{ widget.settings.eyebrow }}</div>{% endif %}
        <h2>{{ widget.settings.heading }}</h2>
        <p class="lede">{{ widget.settings.body }}</p>
        <div class="legend">
          {% for m in widget.settings.markers %}
            <a href="{{ m.url | default: '#' }}" style="--c:{{ m.color | default: '#37ffb0' }}"><i></i>{{ m.name }}<small>{{ m.detail }}</small></a>
          {% endfor %}
        </div>
      </div>
      <div class="oval-map reveal" style="--i:2">
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <defs>
            <linearGradient id="ovg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#37ffb0"/><stop offset=".5" stop-color="#22d3ee"/><stop offset="1" stop-color="#8b5cf6"/></linearGradient>
            <radialGradient id="globe" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#0c1a33"/><stop offset=".75" stop-color="#070d1d"/><stop offset="1" stop-color="#050914"/></radialGradient>
            <linearGradient id="sw" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#37ffb0" stop-opacity="0"/><stop offset="1" stop-color="#37ffb0" stop-opacity=".35"/></linearGradient>
          </defs>
          <circle cx="300" cy="300" r="290" fill="url(#globe)" stroke="rgba(255,255,255,.12)"/>
          <circle class="ring" cx="300" cy="300" r="220"/><circle class="ring" cx="300" cy="300" r="150"/><circle class="ring" cx="300" cy="300" r="80"/>
          <path class="ring" d="M300 10v580M10 300h580M95 95l410 410M505 95L95 505"/>
          <ellipse class="oval" cx="300" cy="288" rx="190" ry="172"/>
          <g class="sweep"><path d="M300 300L300 10A290 290 0 0 1 505 95z" fill="url(#sw)"/></g>
          <circle cx="300" cy="300" r="5" fill="#fff"/>
          <text x="300" y="296" dy="-14" text-anchor="middle" fill="#7d8db0" font-family="monospace" font-size="11" letter-spacing="3">NORTH POLE</text>
        </svg>
        {% for m in widget.settings.markers %}
          <a class="pin{% if m.x > 58 %} left{% endif %}" href="{{ m.url | default: '#' }}" style="left:{{ m.x }}%;top:{{ m.y }}%;--c:{{ m.color | default: '#37ffb0' }}"><i></i><span>{{ m.name }}</span></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
