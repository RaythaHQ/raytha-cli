{% assign c = Target.PublishedContent %}
<section class="article-hero">{% if c.cover.Value %}<img src="{{ c.cover.Value | attachment_redirect_url }}" alt="">{% endif %}</section>
<div class="article-head" style="--mood:{{ c.mood.Value | default: '#b5482a' }}">
  <div class="wrap narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ PathBase }}/">Home</a><a href="{{ PathBase }}/journal">Journal</a><span>{{ c.category.Value | @category }}</span></nav>
    <h1 style="font-size:clamp(2.2rem,5vw,4rem)">{{ Target.PrimaryField }}</h1>
    <p class="lede">{{ c.excerpt.Value }}</p>
    <div style="display:flex;gap:20px;align-items:center;margin:30px 0;padding:22px 0;border-block:1px solid var(--line)">
      {% if c.author %}<a class="person" href="{{ PathBase }}/{{ c.author.RoutePath }}">{% if c.author.PublishedContent.portrait.Value %}<img src="{{ c.author.PublishedContent.portrait.Value | attachment_redirect_url }}" alt="">{% endif %}<span><b>{{ c.author.PrimaryField }}</b><small>{{ c.published_on.Value | date: "%B %e, %Y" }} &middot; {{ c.reading_minutes.Value }} min read</small></span></a>{% endif %}
      <div class="chips" style="margin-left:auto">{% for t in c.tags.Value %}<span class="pill">#{{ t | @tags }}</span>{% endfor %}</div>
    </div>
  </div>
</div>
<div class="wrap narrow" style="padding-bottom:100px">
  <div class="prose">{{ c.body.Value }}</div>
  {% if c.firing_log.Value.size > 0 %}
  <div class="panel" style="margin-top:50px"><h4>Log</h4>
    <div class="tl">{% for l in c.firing_log.Value %}<div class="tl-i"><b>{{ l.hour }}{% if l.temperature > 25 %} &middot; {{ l.temperature }}&deg;C{% endif %}</b><p>{{ l.note }}</p></div>{% endfor %}</div>
  </div>
  {% endif %}
</div>
