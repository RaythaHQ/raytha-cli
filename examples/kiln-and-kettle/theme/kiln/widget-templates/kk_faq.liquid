<section class="section{% if widget.css_class %} {{ widget.css_class }}{% endif %}" {% if widget.html_id %}id="{{ widget.html_id }}"{% endif %}>
  <div class="wrap split" style="grid-template-columns:.7fr 1.3fr;align-items:start">
    <div class="reveal" style="position:sticky;top:120px">
      {% if widget.settings.eyebrow %}<div class="eyebrow">{{ widget.settings.eyebrow }}</div>{% endif %}
      <h2>{{ widget.settings.heading }}</h2>
      {% if widget.settings.intro %}<p class="lede">{{ widget.settings.intro }}</p>{% endif %}
    </div>
    <div class="faq reveal">
      {% for q in widget.settings.items %}<details{% if forloop.first %} open{% endif %}><summary>{{ q.question }}</summary><div>{{ q.answer }}</div></details>{% endfor %}
    </div>
  </div>
</section>
